149-28-251-200.sslip.io {
	# ^ Line 1 is the only domain-specific line. To move to the .TECH domain (after its A record
	#   points at the server):
	#     sudo sed -i '1s/.*/demo.yourname.tech {/' /etc/caddy/Caddyfile && sudo systemctl reload caddy
	#   Caddy then gets a certificate for the new name automatically. To serve both names during the
	#   switch, use "149-28-251-200.sslip.io, demo.yourname.tech {" on line 1 instead.
	# /etc/caddy/Caddyfile for the BreathWatch public demo (deploy/PUBLIC_DEMO.md). Ports 80/443
	# must be open; WebSockets (/ws/ward, /ws/patients/…) are proxied without extra config.
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
	log {
		output file /var/log/caddy/breathwatch.log
	}
}
